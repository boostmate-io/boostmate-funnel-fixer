exports[`registry baseline (Coach-facing) > field-paths prompt is unchanged 1`] = `
"# Blueprint field paths (use these exact dot-paths in propose_blueprint_writes)
# Format: path — kind — label
customer_clarity.avatar_who — textarea — Who is your ideal client?
customer_clarity.avatar_stage — textarea — What stage or situation are they currently in?
customer_clarity.avatar_traits — tags (comma-separated list of short items) — Traits or mindset that define them — Comma-separated list of short items
customer_clarity.avatar_not_fit — textarea — Who is NOT a good fit to be your client?
customer_clarity.pain_main_problem — textarea — What is the main problem they are dealing with?
customer_clarity.pain_daily_frustrations — textarea — What frustrations do they experience because of this?
customer_clarity.pain_already_tried — textarea — What have they already tried?
customer_clarity.pain_consequences — textarea — What happens if they don't solve this?
customer_clarity.desire_main_result — textarea — What result do they want most?
customer_clarity.desire_success_vision — textarea — What would success look and feel like?
customer_clarity.desire_why_badly — textarea — Why do they want this so badly?
customer_clarity.transformation_point_a — textarea — Where are they now?
customer_clarity.transformation_point_b — textarea — Where do they want to be?
customer_clarity.transformation_process — textarea — What needs to change for them to get there? — The key shifts, milestones, or problems that need to be solved between their current and desired state.
offer_stack.angle.main_offer_name — text — Main Offer Name — Short, 3-6 words, name only
offer_stack.angle.short_description — textarea — Short Offer Description — 1-2 sentences
offer_stack.angle.core_outcome — textarea — Core Outcome — Primary transformation result, 1 sentence
offer_stack.angle.angle_new_vehicle — textarea — New Vehicle — What makes the method genuinely NEW
offer_stack.angle.angle_better_results — textarea — Better Results — Why the method produces BETTER results
offer_stack.angle.angle_faster_outcome — textarea — Faster Outcome — How clients get results FASTER
offer_stack.angle.angle_easier_process — textarea — Easier Process — How the process is made EASIER
offer_stack.angle.framework.name — text — Framework / Method Name — Memorable name for the signature method, 2-5 words
offer_stack.angle.framework.description — text — Framework — Brief Description — One line describing what makes the framework unique and why it works
offer_stack.angle.core_promise.desired_outcome — text — Desired Outcome (Core Promise) — Specific transformation the client walks away with
offer_stack.angle.core_promise.timeframe — text — Timeframe (Core Promise) — Use one of: 7_days, 30_days, 60_days, 90_days, 6_months, 12_months, custom
offer_stack.angle.core_promise.timeframe_custom — text — Timeframe — Custom Label — Short custom label when timeframe = custom
offer_stack.angle.core_promise.guarantee — text — Guarantee / Risk Reversal — Optional risk reversal promise, one sentence
offer_stack.angle.framework.pillars.0.name — text — Pillar 1 — Name — Short name for this pillar of the signature framework
offer_stack.angle.framework.pillars.0.description — textarea — Pillar 1 — Description — What happens in this pillar, 1-2 sentences
offer_stack.angle.framework.pillars.1.name — text — Pillar 2 — Name — Short name for this pillar of the signature framework
offer_stack.angle.framework.pillars.1.description — textarea — Pillar 2 — Description — What happens in this pillar, 1-2 sentences
offer_stack.angle.framework.pillars.2.name — text — Pillar 3 — Name — Short name for this pillar of the signature framework
offer_stack.angle.framework.pillars.2.description — textarea — Pillar 3 — Description — What happens in this pillar, 1-2 sentences
offer_stack.stack.delivery_timeline — text — Delivery Timeline — Use one of: 7_days, 30_days, 60_days, 90_days, 6_months, 12_months, custom
offer_stack.stack.delivery_timeline_custom — text — Delivery Timeline — Custom Label — Short custom label when delivery_timeline = custom
offer_stack.stack.deliverables.0.name — text — Deliverable 1 — Name — Short, benefit-driven name for a core deliverable
offer_stack.stack.deliverables.0.description — textarea — Deliverable 1 — Description — 1-2 sentences describing what the client receives and how it works
offer_stack.stack.deliverables.0.frequency — text — Deliverable 1 — Frequency — One of: one_time | daily | weekly | biweekly | monthly | quarterly | ongoing
offer_stack.stack.deliverables.1.name — text — Deliverable 2 — Name — Short, benefit-driven name for a core deliverable
offer_stack.stack.deliverables.1.description — textarea — Deliverable 2 — Description — 1-2 sentences describing what the client receives and how it works
offer_stack.stack.deliverables.1.frequency — text — Deliverable 2 — Frequency — One of: one_time | daily | weekly | biweekly | monthly | quarterly | ongoing
offer_stack.stack.deliverables.2.name — text — Deliverable 3 — Name — Short, benefit-driven name for a core deliverable
